{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "types": ["vite/client", "node"],
    "paths": {
      "vue-cdk": ["../packages/cdk/src/index.ts"],
      "vue-cdk/*": ["../packages/cdk/src/*/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.vue"]
}
