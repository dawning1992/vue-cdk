{
  "name": "vue-cdk",
  "version": "0.1.0-beta.1",
  "description": "Vue 3 组件开发工具包（CDK），借鉴 Angular CDK 的设计模式，以模块化子路径提供可组合的基础能力",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./bidi": {
      "types": "./dist/bidi/index.d.ts",
      "import": "./dist/bidi/index.js",
      "require": "./dist/bidi/index.cjs"
    },
    "./overlay": {
      "types": "./dist/overlay/index.d.ts",
      "import": "./dist/overlay/index.js",
      "require": "./dist/overlay/index.cjs"
    },
    "./overlay/style.css": "./dist/overlay/style.css",
    "./coercion": {
      "types": "./dist/coercion/index.d.ts",
      "import": "./dist/coercion/index.js",
      "require": "./dist/coercion/index.cjs"
    },
    "./clipboard": {
      "types": "./dist/clipboard/index.d.ts",
      "import": "./dist/clipboard/index.js",
      "require": "./dist/clipboard/index.cjs"
    },
    "./accordion": {
      "types": "./dist/accordion/index.d.ts",
      "import": "./dist/accordion/index.js",
      "require": "./dist/accordion/index.cjs"
    },
    "./stepper": {
      "types": "./dist/stepper/index.d.ts",
      "import": "./dist/stepper/index.js",
      "require": "./dist/stepper/index.cjs"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "import": "./dist/platform/index.js",
      "require": "./dist/platform/index.cjs"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.js",
      "require": "./dist/layout/index.cjs"
    },
    "./scrolling": {
      "types": "./dist/scrolling/index.d.ts",
      "import": "./dist/scrolling/index.js",
      "require": "./dist/scrolling/index.cjs"
    },
    "./scrolling/style.css": "./dist/scrolling/style.css",
    "./collections": {
      "types": "./dist/collections/index.d.ts",
      "import": "./dist/collections/index.js",
      "require": "./dist/collections/index.cjs"
    },
    "./emitter": {
      "types": "./dist/emitter/index.d.ts",
      "import": "./dist/emitter/index.js",
      "require": "./dist/emitter/index.cjs"
    },
    "./portal": {
      "types": "./dist/portal/index.d.ts",
      "import": "./dist/portal/index.js",
      "require": "./dist/portal/index.cjs"
    },
    "./a11y": {
      "types": "./dist/a11y/index.d.ts",
      "import": "./dist/a11y/index.js",
      "require": "./dist/a11y/index.cjs"
    },
    "./a11y/style.css": "./dist/a11y/style.css",
    "./dialog": {
      "types": "./dist/dialog/index.d.ts",
      "import": "./dist/dialog/index.js",
      "require": "./dist/dialog/index.cjs"
    },
    "./dialog/style.css": "./dist/dialog/style.css",
    "./drag-drop": {
      "types": "./dist/drag-drop/index.d.ts",
      "import": "./dist/drag-drop/index.js",
      "require": "./dist/drag-drop/index.cjs"
    },
    "./drag-drop/style.css": "./dist/drag-drop/style.css",
    "./tree": {
      "types": "./dist/tree/index.d.ts",
      "import": "./dist/tree/index.js",
      "require": "./dist/tree/index.cjs"
    },
    "./virtual-tree": {
      "types": "./dist/virtual-tree/index.d.ts",
      "import": "./dist/virtual-tree/index.js",
      "require": "./dist/virtual-tree/index.cjs"
    },
    "./text-field": {
      "types": "./dist/text-field/index.d.ts",
      "import": "./dist/text-field/index.js",
      "require": "./dist/text-field/index.cjs"
    },
    "./observers": {
      "types": "./dist/observers/index.d.ts",
      "import": "./dist/observers/index.js",
      "require": "./dist/observers/index.cjs"
    },
    "./text-field/style.css": "./dist/text-field/style.css",
    "./text-field/index": "./dist/text-field/_index.scss",
    "./text-field/text-field-prebuilt.scss": "./dist/text-field/text-field-prebuilt.scss"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "keywords": [
    "vue",
    "vue3",
    "cdk",
    "bidi",
    "rtl",
    "component",
    "layout",
    "responsive",
    "overlay",
    "popover",
    "dropdown",
    "tooltip",
    "clipboard",
    "accordion",
    "stepper",
    "teleport",
    "portal",
    "drag-drop",
    "draggable",
    "tree",
    "treeview",
    "virtual-tree",
    "virtual-scroll",
    "text-field",
    "textarea-autosize",
    "autofill",
    "mutation-observer",
    "content-observer"
  ],
  "license": "MIT",
  "scripts": {
    "build": "vite build && node scripts/copy-a11y-css.mjs && node scripts/copy-dialog-css.mjs && node scripts/copy-scrolling-css.mjs && node scripts/copy-drag-drop-css.mjs && node scripts/copy-text-field-assets.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run test:browser && pnpm run build && node scripts/check-version.mjs"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "4.1.10",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "sass": "^1.102.0",
    "typescript": "~5.9.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9"
  }
}
